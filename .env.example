# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for metadata and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI providers
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# Stripe (use test-mode keys: sk_test_...)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Stripe Dashboard → Developers → Webhooks → your endpoint).
# For local testing any value works with pnpm test:billing, which signs its own events.
STRIPE_WEBHOOK_SECRET=
